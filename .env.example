# ─────────────────────────────────────────────────────────────────────────────
# AMSAT Satellite Status — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# This is consumed by deploy/docker-compose.yml on the production host. In
# GitHub Actions, the `secrets`-marked values come from repo/org Secrets and
# the `vars`-marked values come from repo/org Variables — see the
# configure-env job in .github/workflows/cd.yml.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ──────────────────────────────────────────────────────────────────────
# [var] Public base URL of the deployed site. Include the scheme, no
# trailing slash (a trailing slash is stripped automatically, but the
# scheme is not assumed — always include http:// or https://). Used by
# both the frontend and API containers, and must be the SAME value for
# both in production: they're reached through the same host, and the API
# derives its own base URL ($SITE_URL/api/v1) from it. Point this at
# your own domain if you're deploying this somewhere other than
# status.amsat.org.
SITE_URL=https://status.amsat.org

# ── MySQL / MariaDB — app connection (read by frontend/v1 and api/v1) ────────
# [var] Compose service name of the database container
MYSQL_HOST=db
# [var] App database username
MYSQL_USER=satellite
# [secret] App database password
MYSQL_PASSWORD=your_mysql_password_here
# [var] App database name
MYSQL_DATABASE=satellite_status

# ── MariaDB — container init (read by the mariadb image itself) ─────────────
# Always true for this stack: no root password is ever set. MariaDB generates
# a random, inaccessible root password at init time instead. There is no
# MARIADB_ROOT_PASSWORD here by design — see CD_NOTES.md.
MARIADB_RANDOM_ROOT_PASSWORD=yes
# [var] Same value as MYSQL_DATABASE above
MARIADB_DATABASE=satellite_status
# [var] Same value as MYSQL_USER above
MARIADB_USER=satellite
# [secret] Same value as MYSQL_PASSWORD above
MARIADB_PASSWORD=your_mysql_password_here
