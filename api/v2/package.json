{
  "name": "satellite-status-api-v2",
  "version": "0.1.0",
  "private": true,
  "description": "AMSAT satellite status API v2 (TypeScript). See docs/agents/api-v2-stack.md.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:types": "kysely-codegen --dialect mysql --out-file src/db/types.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "@fastify/type-provider-typebox": "^6.3.0",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.12.8",
    "kysely": "^0.29.9",
    "mysql2": "^3.24.6",
    "typebox": "^1.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "kysely-codegen": "^0.20.0",
    "typescript": "~6.0.2",
    "vitest": "^5.1.0"
  }
}
