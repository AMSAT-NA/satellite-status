{
    "openapi": "3.0.3",
    "info": {
        "title": "AMSAT Satellite Status API",
        "description": "Public API for amateur satellite status reports. Before building on it, read the usage guidelines (linked as Terms of Service): identify your client with a descriptive User-Agent, poll no more often than every 5 minutes, and submit only real observations made by the operator whose callsign the report carries. Code is licensed under Apache-2.0; report data is available under CC BY 4.0 with attribution.",
        "termsOfService": "https://status.amsat.org/api/v1/overview.php#usage",
        "contact": {
            "name": "AMSAT IT",
            "url": "https://github.com/AMSAT-NA/satellite-status/issues",
            "email": "IT@amsat.org"
        },
        "license": {
            "name": "Apache-2.0",
            "url": "https://www.apache.org/licenses/LICENSE-2.0"
        },
        "version": "1.3"
    },
    "servers": [
        {
            "url": "/api/v1",
            "description": "Current host"
        }
    ],
    "paths": {
        "/catalog.php": {
            "get": {
                "tags": [
                    "Catalog"
                ],
                "summary": "List satellites with links and optional report statistics.",
                "operationId": "getCatalog",
                "parameters": [
                    {
                        "name": "name",
                        "in": "query",
                        "description": "Exact satellite API name or display name. No match returns 404 satellite_not_found.",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "include_stats",
                        "in": "query",
                        "description": "Add report_count and latest_reported_time to each satellite. Accepts 1, true, yes or on; anything else is false.",
                        "required": false,
                        "schema": {
                            "type": "boolean"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Catalog response.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Satellite"
                                            }
                                        },
                                        "meta": {
                                            "properties": {
                                                "count": {
                                                    "type": "integer"
                                                },
                                                "api_version": {
                                                    "description": "API version, MAJOR.MINOR. Same value as the X-AMSAT-API-Version header.",
                                                    "type": "string",
                                                    "example": "1.3"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Satellite not found (satellite_not_found).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/reports.php": {
            "get": {
                "tags": [
                    "Reports"
                ],
                "summary": "Search recent satellite reports.",
                "operationId": "getReports",
                "parameters": [
                    {
                        "name": "name",
                        "in": "query",
                        "description": "Exact satellite API name or display name, as listed by /catalog.php. A display name is resolved to its API name. An unknown name returns 404 satellite_not_found.",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "hours",
                        "in": "query",
                        "description": "Rolling UTC window, in hours. Ignored when since is given. Out-of-range values are clamped to the nearest bound, not rejected; a non-integer returns 400 invalid_parameter.",
                        "schema": {
                            "type": "integer",
                            "default": 72,
                            "maximum": 720,
                            "minimum": 1
                        }
                    },
                    {
                        "name": "since",
                        "in": "query",
                        "description": "Return reports observed at or after this time (ISO 8601): compared with observation_time, not submission_time. Overrides hours. An unparseable value returns 400 invalid_since.",
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "description": "Maximum number of reports, newest first. Out-of-range values are clamped to the nearest bound, not rejected; a non-integer returns 400 invalid_parameter.",
                        "schema": {
                            "type": "integer",
                            "default": 100,
                            "maximum": 500,
                            "minimum": 1
                        }
                    },
                    {
                        "name": "callsign",
                        "in": "query",
                        "description": "Exact callsign, case-insensitive.",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "grid_square",
                        "in": "query",
                        "description": "Exact Maidenhead locator, case-insensitive. A 4-character grid does not match 6-character reports. An invalid locator returns 400 invalid_grid_square.",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "description": "Report value. Accepts the same aliases as POST /reports.php. An unsupported value returns 400 invalid_status.",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "Heard",
                                "Telemetry Only",
                                "Not Heard",
                                "Crew Active"
                            ]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Report search response.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Report"
                                            }
                                        },
                                        "meta": {
                                            "properties": {
                                                "count": {
                                                    "type": "integer"
                                                },
                                                "limit": {
                                                    "description": "The limit applied, after clamping.",
                                                    "type": "integer"
                                                },
                                                "since": {
                                                    "description": "The lower bound applied, normalized to UTC.",
                                                    "type": "string",
                                                    "format": "date-time"
                                                },
                                                "hours": {
                                                    "description": "The hours value after clamping (default 72). Still present when since was given, but not applied.",
                                                    "type": "integer"
                                                },
                                                "api_version": {
                                                    "description": "API version, MAJOR.MINOR. Same value as the X-AMSAT-API-Version header.",
                                                    "type": "string",
                                                    "example": "1.3"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid filter (invalid_parameter, invalid_since, invalid_grid_square or invalid_status).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Satellite not found (satellite_not_found).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Reports"
                ],
                "summary": "Submit a satellite status report.",
                "operationId": "createReport",
                "requestBody": {
                    "description": "Send JSON with Content-Type: application/json, or form data (application/x-www-form-urlencoded).",
                    "required": true,
                    "content": {
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/ReportCreate"
                            }
                        },
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ReportCreate"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Report created.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "properties": {
                                                "id": {
                                                    "type": "integer"
                                                },
                                                "name": {
                                                    "type": "string"
                                                },
                                                "observation_time": {
                                                    "description": "When the satellite was heard (UTC).",
                                                    "type": "string",
                                                    "format": "date-time"
                                                },
                                                "submission_time": {
                                                    "description": "When the server received this report (UTC).",
                                                    "type": "string",
                                                    "format": "date-time"
                                                },
                                                "reported_time": {
                                                    "description": "Deprecated: use observation_time. Same value.",
                                                    "type": "string",
                                                    "format": "date-time",
                                                    "deprecated": true
                                                },
                                                "callsign": {
                                                    "type": "string"
                                                },
                                                "report": {
                                                    "type": "string"
                                                },
                                                "grid_square": {
                                                    "type": "string"
                                                },
                                                "correction": {
                                                    "description": "True if this report corrects an earlier one: the same callsign already reported this satellite in the same 15-minute UTC period (:00-:14, :15-:29, :30-:44, :45-:59). The earlier report is kept but no longer counted or returned. False if this is the first report from this callsign for that period.",
                                                    "type": "boolean"
                                                }
                                            },
                                            "type": "object"
                                        },
                                        "links": {
                                            "properties": {
                                                "satellite_reports": {
                                                    "type": "string",
                                                    "format": "uri"
                                                }
                                            },
                                            "type": "object"
                                        },
                                        "meta": {
                                            "properties": {
                                                "api_version": {
                                                    "description": "API version, MAJOR.MINOR. Same value as the X-AMSAT-API-Version header.",
                                                    "type": "string",
                                                    "example": "1.3"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Request body is not valid JSON (invalid_json).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation failed (missing_name, unknown_satellite, invalid_report, invalid_callsign, invalid_grid_square, invalid_observation_time, conflicting_observation_time, future_observation_time, invalid_reported_at, missing_reported_at or future_reported_at).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/summary.php": {
            "get": {
                "tags": [
                    "Reports"
                ],
                "summary": "Summarize report activity by satellite and report status.",
                "description": "Counts are per satellite and report value over a rolling UTC window. As in API 1.0, a resubmission from the same callsign for the same satellite and 15-minute UTC period corrects the earlier report: only the latest one is counted. Corrected reports are still stored, but are not counted here or returned by /reports.php.",
                "operationId": "getSummary",
                "parameters": [
                    {
                        "name": "hours",
                        "in": "query",
                        "description": "Rolling UTC window, in hours. Out-of-range values are clamped to the nearest bound, not rejected; a non-integer returns 400 invalid_parameter.",
                        "schema": {
                            "type": "integer",
                            "default": 24,
                            "maximum": 720,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Summary response: one entry per satellite and report value, ordered by satellite name, then count.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/SummaryEntry"
                                            }
                                        },
                                        "meta": {
                                            "properties": {
                                                "hours": {
                                                    "description": "The window applied, after clamping.",
                                                    "type": "integer"
                                                },
                                                "count": {
                                                    "type": "integer"
                                                },
                                                "api_version": {
                                                    "description": "API version, MAJOR.MINOR. Same value as the X-AMSAT-API-Version header.",
                                                    "type": "string",
                                                    "example": "1.3"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "hours is not an integer (invalid_parameter).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/statuses.php": {
            "get": {
                "tags": [
                    "Metadata"
                ],
                "summary": "List canonical report status values.",
                "operationId": "getStatuses",
                "responses": {
                    "200": {
                        "description": "Status values response.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/StatusValue"
                                            }
                                        },
                                        "meta": {
                                            "properties": {
                                                "count": {
                                                    "type": "integer"
                                                },
                                                "api_version": {
                                                    "description": "API version, MAJOR.MINOR. Same value as the X-AMSAT-API-Version header.",
                                                    "type": "string",
                                                    "example": "1.3"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/health.php": {
            "get": {
                "tags": [
                    "Metadata"
                ],
                "summary": "Check API and database availability, and data freshness.",
                "description": "Returns 200 whenever the database is reachable. status is \"ok\" when data is fresh, or \"degraded\" when there are no reports (reason no_reports) or the newest report is older than data_freshness.stale_after_seconds (reason stale_data). Freshness is the newest report's receive time, or its observation time for reports imported before receive times were recorded.",
                "operationId": "getHealth",
                "responses": {
                    "200": {
                        "description": "Database reachable; status is \"ok\" or \"degraded\".",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "properties": {
                                                "status": {
                                                    "type": "string",
                                                    "enum": [
                                                        "ok",
                                                        "degraded"
                                                    ]
                                                },
                                                "reason": {
                                                    "description": "Present only when status is \"degraded\".",
                                                    "type": "string",
                                                    "enum": [
                                                        "no_reports",
                                                        "stale_data"
                                                    ]
                                                },
                                                "version": {
                                                    "type": "string",
                                                    "example": "1.3"
                                                },
                                                "time": {
                                                    "type": "string",
                                                    "format": "date-time"
                                                },
                                                "data_freshness": {
                                                    "properties": {
                                                        "latest_report_time": {
                                                            "type": "string",
                                                            "format": "date-time",
                                                            "nullable": true
                                                        },
                                                        "age_seconds": {
                                                            "type": "integer",
                                                            "nullable": true
                                                        },
                                                        "stale_after_seconds": {
                                                            "type": "integer",
                                                            "example": 86400
                                                        }
                                                    },
                                                    "type": "object"
                                                }
                                            },
                                            "type": "object"
                                        },
                                        "meta": {
                                            "properties": {
                                                "api_version": {
                                                    "description": "API version, MAJOR.MINOR. Same value as the X-AMSAT-API-Version header.",
                                                    "type": "string",
                                                    "example": "1.3"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Database is unavailable (database_unavailable or database_unhealthy).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/satellites.php": {
            "get": {
                "tags": [
                    "Legacy"
                ],
                "summary": "Legacy-compatible satellite catalog array.",
                "operationId": "getLegacySatellites",
                "responses": {
                    "200": {
                        "description": "Plain JSON array of satellites.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/LegacySatellite"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/sat_info.php": {
            "get": {
                "tags": [
                    "Legacy"
                ],
                "summary": "Legacy-compatible satellite report array.",
                "operationId": "getLegacySatInfo",
                "parameters": [
                    {
                        "name": "name",
                        "in": "query",
                        "description": "Satellite API name. If missing or unknown, the response is an empty array.",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "hours",
                        "in": "query",
                        "description": "Rolling UTC window, in hours. Out-of-range values are clamped to the nearest bound; a non-numeric value is ignored and the default is used.",
                        "schema": {
                            "type": "integer",
                            "default": 72,
                            "maximum": 96,
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Plain JSON array of up to 100 reports, newest first.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/LegacyReport"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ErrorResponse": {
                "description": "Error envelope used by every endpoint for errors, including the legacy satellites.php and sat_info.php (only their successful responses are plain arrays). code is stable and meant for programs; message is for people and may change. New codes may be added. Each endpoint documents its own request-specific errors; in addition, any endpoint can return 405 method_not_allowed, 500 and 503 as listed below, which are not repeated per endpoint. Codes by HTTP status -- 400: invalid_parameter (hours or limit is not an integer), invalid_since, invalid_grid_square, invalid_status, invalid_json. 404: satellite_not_found. 405: method_not_allowed (any endpoint; the Allow header lists the supported methods). 422: missing_name, unknown_satellite, invalid_report, invalid_callsign, invalid_grid_square, invalid_observation_time, conflicting_observation_time, future_observation_time, invalid_reported_at, missing_reported_at, future_reported_at. 500: query_failed, query_prepare_failed, write_failed. 503: database_unavailable (any endpoint that reads the database), database_unhealthy (health.php), openapi_spec_missing (openapi.php and the /api/v1/ index).",
                "properties": {
                    "error": {
                        "properties": {
                            "code": {
                                "type": "string",
                                "example": "invalid_parameter"
                            },
                            "message": {
                                "type": "string"
                            },
                            "status": {
                                "type": "integer",
                                "example": 400
                            },
                            "details": {
                                "description": "Present on some errors only: the rejected parameter and value for invalid_parameter, or allowed_values for invalid_report.",
                                "type": "object",
                                "additionalProperties": true
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "ReportCreate": {
                "description": "New clients should send name, report, callsign, grid_square and observation_time. The observation time is required: send observation_time, or one of the deprecated alternatives (reported_at, or year, month, day and hour). The other fields are accepted for compatibility with older clients.",
                "required": [
                    "name",
                    "report",
                    "callsign"
                ],
                "properties": {
                    "name": {
                        "description": "Satellite API name or display name, as listed by /catalog.php. A display name is resolved to its API name, which is what is stored and returned.",
                        "type": "string",
                        "example": "AO-91"
                    },
                    "report": {
                        "description": "Report value. Matched case-insensitively, and these aliases are also accepted: active, satellite active (Heard); telemetry, beacon, telemetry/beacon only (Telemetry Only); no signal (Not Heard); iss crew active, iss crew (voice) active (Crew Active).",
                        "type": "string",
                        "enum": [
                            "Heard",
                            "Telemetry Only",
                            "Not Heard",
                            "Crew Active"
                        ],
                        "example": "Heard"
                    },
                    "callsign": {
                        "description": "Amateur radio callsign, uppercased and truncated to 14 characters. If grid_square is empty and the callsign ends in a grid square after - or / (for example N0CALL/EM48), the grid is taken from the callsign.",
                        "type": "string",
                        "example": "N0CALL"
                    },
                    "grid_square": {
                        "description": "Optional Maidenhead locator (4 or 6 characters).",
                        "type": "string",
                        "example": "EM48"
                    },
                    "observation_time": {
                        "description": "When the satellite was heard (not when the report is submitted). ISO 8601 date and time with an explicit UTC offset: Z, +HH:MM, +HHMM or +HH (or -), for example 2026-05-23T08:30:00Z. A timestamp without an offset is rejected (invalid_observation_time). A space may replace T. Seconds are optional; fractional seconds are dropped. Must not be in the future (future_observation_time). If reported_at is also sent, both must be the same instant, or the request fails with conflicting_observation_time.",
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-05-23T08:30:00Z"
                    },
                    "reported_at": {
                        "description": "Deprecated: use observation_time. Kept for the life of /api/v1. Any ISO 8601 timestamp is parsed (a timestamp without an offset is read as UTC). Used only when observation_time is absent.",
                        "type": "string",
                        "format": "date-time",
                        "deprecated": true
                    },
                    "satellite": {
                        "description": "Alias for name. Used only when name is absent.",
                        "type": "string"
                    },
                    "status": {
                        "description": "Alias for report. Used only when report is absent.",
                        "type": "string"
                    },
                    "year": {
                        "description": "Deprecated: use observation_time. Legacy time fields, used only when observation_time and reported_at are both absent: year, month, day and hour (UTC) are then all required.",
                        "type": "integer",
                        "deprecated": true
                    },
                    "month": {
                        "description": "Deprecated; see year.",
                        "type": "integer",
                        "deprecated": true
                    },
                    "day": {
                        "description": "Deprecated; see year.",
                        "type": "integer",
                        "deprecated": true
                    },
                    "hour": {
                        "description": "Deprecated; see year. 0-23, UTC.",
                        "type": "integer",
                        "deprecated": true
                    },
                    "minute": {
                        "description": "Deprecated; see year. 0-59. Defaults to 30 if omitted, so legacy clients should always send it.",
                        "type": "integer",
                        "deprecated": true
                    }
                },
                "type": "object"
            },
            "Report": {
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string",
                        "example": "AO-91"
                    },
                    "satellite_display_name": {
                        "type": "string",
                        "nullable": true
                    },
                    "observation_time": {
                        "description": "When the satellite was heard (UTC).",
                        "type": "string",
                        "format": "date-time"
                    },
                    "submission_time": {
                        "description": "When the server received the report (UTC). Null for reports stored before receive times were recorded (November 2026).",
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "reported_time": {
                        "description": "Deprecated: use observation_time. Same value.",
                        "type": "string",
                        "format": "date-time",
                        "deprecated": true
                    },
                    "callsign": {
                        "type": "string"
                    },
                    "report": {
                        "type": "string"
                    },
                    "grid_square": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "Satellite": {
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string",
                        "example": "AO-91"
                    },
                    "display_name": {
                        "type": "string",
                        "example": "AO-91 Mode U/v FM"
                    },
                    "website": {
                        "type": "string"
                    },
                    "links": {
                        "properties": {
